# Copy to .env.local and fill in. Never commit real values.

# Public site origin — canonicals, sitemap.xml, robots.txt, and OG URLs all
# derive from it. Unset = http://localhost:3000 gets baked into the static build.
NEXT_PUBLIC_SITE_URL=https://masalphasecurities.com

# Supabase — "leads" table inserts from the contact API route
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — partner-inquiry notification emails
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=ir@masalphasecurities.com
# Verified Resend sender — falls back to Resend's sandbox sender if unset
CONTACT_FROM_EMAIL=
