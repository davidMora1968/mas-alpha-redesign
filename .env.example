# Copy to .env.local and fill in. Never commit real values.

# Public site origin — canonicals, sitemap.xml, robots.txt, and OG URLs all
# derive from it. Unset = http://localhost:3000 gets baked into the static build.
NEXT_PUBLIC_SITE_URL=https://masalphasecurities.com

# Supabase — "leads" table inserts from the contact API route
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — partner-inquiry notifications + the Monday Brief
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=ir@masalphasecurities.com
# Verified Resend sender — falls back to Resend's sandbox sender if unset
CONTACT_FROM_EMAIL=

# The Monday Brief (app/api/brief, Vercel cron — see vercel.json)
# Random string; Vercel sends it as the cron Authorization header. Without it
# the brief never sends. Preview (never put the secret in a URL):
#   curl -H "Authorization: Bearer $CRON_SECRET" "https://<site>/api/brief?dry=1"
CRON_SECRET=
# Comma-separated recipients; falls back to CONTACT_NOTIFY_EMAIL
BRIEF_RECIPIENTS=
